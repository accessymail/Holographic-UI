{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist/lib",
    "rootDir": "src",
    "jsx": "react-jsx",
    "isolatedModules": true
  },
  "include": ["src/index.ts", "src/react/index.ts", "src/core/**/*.ts", "src/runtime/**/*.ts", "src/sdk/**/*.ts", "src/connectors/**/*.ts", "src/adapters/**/*.ts"],
  "exclude": ["src/app", "src/ui", "src/main.tsx", "src/**/__tests__/**"]
}
